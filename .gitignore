# Holds the Windows Computer History folder open until it has code: git does
# not track empty directories, and `.*` above would otherwise drop the marker.
!App/memmy-agent/src/tools/computer-history/win/.gitkeep
App/backend/src/adapters/outbound/skill-writer/workspace-bridge/memmy-workspace-bridge.mjs
Memory/src/agent-source/integration/workspace-bridge/memmy-workspace-bridge.mjs
/Mac软件打包/
# Local design drafts and review notes; mirrored from DingTalk, not shipped.
/design-docs/

# Project-memory eval replay databases; rebuilt by scripts/project-memory/eval/run-recall.ts.
/eval/project-memory/runs/**/*-recall-db/

# Fixture workspaces are initialized as empty git repos and have no commits.
/eval/project-memory/workspaces/*/.git/

# Eval outputs (runs, reports, judge and reader caches) go to eval/project-memory/runs/ and are
# regenerated per run; only dataset/gold.json and metrics.md summaries are committed.
/eval/project-memory/gold-add-memory/generated/
/eval/project-memory/runs/
/eval/project-memory/gold-add-memory/harness/memory-service/
